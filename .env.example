# Optional ListenBrainz token
LISTENBRAINZ_TOKEN=

# Optional Subsonic/Navidrome connection
SUBSONIC_BASE_URL=
SUBSONIC_USERNAME=
SUBSONIC_PASSWORD=

# Station / queue behavior
HELIX_PREFETCH_AHEAD=3
HELIX_LOBBY_YT_LINK_MAX_ITEMS=100

# Public-safe defaults
HELIX_ENABLE_API_DOCS=false
HELIX_ALLOW_NON_ADMIN_IMPORT=false

# Session cookie security
# Keep this true when Helix is served over HTTPS.
# Set it to false when accessing Helix directly over plain HTTP
# (for example, http://192.168.1.50:8000), otherwise the browser
# will not send the Secure session cookie and you will appear to
# be logged out immediately after signing in.
HELIX_COOKIE_SECURE=true

# Cross-origin (CSRF) guard: which browser origins may issue non-safe
# requests (POST/PUT/PATCH/DELETE). The guard compares the request Origin
# (or Referer fallback) against the configured origins only — it never trusts
# the request's own Host header.
# MR_FRONTEND_ORIGIN is the primary origin (also used by CORS). Add any extra
# trusted origins (e.g. a reverse-proxy host, a second UI) as a
# comma-separated list.
MR_FRONTEND_ORIGIN=http://localhost:8080
# HELIX_ALLOWED_ORIGINS=https://music.example.com,http://192.168.1.50:8080

# Rate limiting is keyed on the transport peer address (the socket's client
# IP), which a client cannot spoof. Set this to true ONLY when Helix is
# directly behind a reverse proxy you trust to set X-Forwarded-For; otherwise
# leave it unset so the peer address is always used.
# HELIX_TRUST_PROXY=false

# Custom station providers
HELIX_ENABLE_CUSTOM_STATION_TYPES=false
HELIX_CUSTOM_STATION_TYPES_DIR=/data/plugins/stations

# Optional DB watchdog tuning
HELIX_DB_WATCHDOG_WARN_S=2
HELIX_DB_WATCHDOG_ERROR_S=10

# yt-dlp freshness
# Enabled by default because YouTube changes can break playback/downloads
# when yt-dlp becomes stale. If the update fails at startup, Helix will
# continue with the bundled yt-dlp version and log a warning.
HELIX_YTDLP_AUTO_UPDATE=true

# Supported values: stable, nightly
HELIX_YTDLP_CHANNEL=stable
